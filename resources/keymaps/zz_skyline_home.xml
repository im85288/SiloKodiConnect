<!-- Silo Skyline: Home keys. Copy to userdata/keymaps/ (named to load after
     other keymaps, which it overrides only for these keys):
       the context menu (C, Menu, a long OK) on Home: on a Continue Watching
       or Next Up card, Silo's menu (Remove from Continue Watching); on
       anything else, Kodi's own. A skin's card isn't a library item, so
       Kodi has no context menu for it.
       Play/Pause on Home, Movies and Series: a library title's card plays (a
       show at its next episode), as the hero's Play; elsewhere, as usual.
     And on Skyline's YouTube page (custom window 1198, which Kodi numbers
     11198): Play, or Play choosing the video's quality; and Back closes a
     search's results (else Back as usual). And on its person page (1195,
     11195): a title Not on server offers Request. -->
<keymap>
  <home>
    <keyboard>
      <c>RunPlugin(plugin://plugin.video.kodiconnectforsilo/?mode=homemenu)</c>
      <menu>RunPlugin(plugin://plugin.video.kodiconnectforsilo/?mode=homemenu)</menu>
      <return mod="longpress">RunPlugin(plugin://plugin.video.kodiconnectforsilo/?mode=homemenu)</return>
      <enter mod="longpress">RunPlugin(plugin://plugin.video.kodiconnectforsilo/?mode=homemenu)</enter>
      <play_pause>RunPlugin(plugin://plugin.video.kodiconnectforsilo/?mode=homeplay)</play_pause>
    </keyboard>
    <remote>
      <menu>RunPlugin(plugin://plugin.video.kodiconnectforsilo/?mode=homemenu)</menu>
      <title>RunPlugin(plugin://plugin.video.kodiconnectforsilo/?mode=homemenu)</title>
      <play>RunPlugin(plugin://plugin.video.kodiconnectforsilo/?mode=homeplay)</play>
    </remote>
  </home>
  <window11198>
