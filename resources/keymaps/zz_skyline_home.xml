<?xml version="1.0" encoding="UTF-8"?>
<!-- Silo Skyline: Home keys. Copy to userdata/keymaps/ (named to load after
     other keymaps, which it overrides only for these keys):
       the context menu (C, Menu, a long OK) on Home: on a Continue Watching
       or Next Up card, Silo's menu (Remove from Continue Watching); on
       anything else, Kodi's own. A skin's card isn't a library item, so
       Kodi has no context menu for it.
     And on Skyline's YouTube page (custom window 1198, which Kodi numbers
     11198): Play, or Play choosing the video's quality; and Back closes a
     search's results (else Back as usual). -->
<keymap>
  <home>
    <keyboard>
      <c>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=homemenu)</c>
      <menu>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=homemenu)</menu>
      <return mod="longpress">RunPlugin(plugin://plugin.video.silokodiconnect/?mode=homemenu)</return>
      <enter mod="longpress">RunPlugin(plugin://plugin.video.silokodiconnect/?mode=homemenu)</enter>
    </keyboard>
    <remote>
      <menu>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=homemenu)</menu>
      <title>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=homemenu)</title>
    </remote>
  </home>
  <window11198>
    <keyboard>
      <backspace>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubeback)</backspace>
      <browser_back>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubeback)</browser_back>
      <c>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubemenu)</c>
      <menu>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubemenu)</menu>
      <return mod="longpress">RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubemenu)</return>
      <enter mod="longpress">RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubemenu)</enter>
    </keyboard>
    <remote>
      <back>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubeback)</back>
      <menu>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubemenu)</menu>
      <title>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubemenu)</title>
    </remote>
  </window11198>
  <window1198>
    <keyboard>
      <backspace>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubeback)</backspace>
      <browser_back>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubeback)</browser_back>
      <c>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubemenu)</c>
      <menu>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubemenu)</menu>
      <return mod="longpress">RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubemenu)</return>
      <enter mod="longpress">RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubemenu)</enter>
    </keyboard>
    <remote>
      <back>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubeback)</back>
      <menu>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubemenu)</menu>
      <title>RunPlugin(plugin://plugin.video.silokodiconnect/?mode=youtubemenu)</title>
    </remote>
  </window1198>
</keymap>
